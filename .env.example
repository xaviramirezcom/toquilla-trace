# Copy to .env and fill in. Never commit .env. (Decision D24.)

# Web app (Vercel + local). Public values: RLS protects the data.
# To run locally against the hosted project, only these two are needed (then npm run dev).
NEXT_PUBLIC_SUPABASE_URL=https://mflvsnpyckuwhicvgnsr.supabase.co
# The anon key is public by design (it ships in the live site's JavaScript). It is in the
# submission note, or with project access: npx supabase projects api-keys --project-ref mflvsnpyckuwhicvgnsr
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local scripts only (npm run logs, seed:users, eval:reset, verify:security). NEVER put this on Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Demo accounts for scripts/seed-users.mjs (npm run seed:users). Created email-confirmed.
# The password is shared with reviewers in the submission note, never committed.
DEMO_ADMIN_EMAIL=
DEMO_MEMBER_EMAIL=
DEMO_BUYER_EMAIL=
DEMO_PASSWORD=

# Eval runner (npm run eval): Eval Workshop member created by seed-users.
# Defaults: EVAL_EMAIL=eval@test.com, EVAL_PASSWORD falls back to DEMO_PASSWORD.
EVAL_EMAIL=
EVAL_PASSWORD=

# The LLM key is NOT here. GEMINI_API_KEY and GEMINI_MODEL (default gemini-2.5-flash-lite)
# live in Supabase secrets: npx supabase secrets set GEMINI_API_KEY=... (decision D26).
