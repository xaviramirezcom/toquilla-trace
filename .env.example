# Copy to .env and fill in. Never commit .env. (Decision D24.)

# Web app (Vercel + local). Public values: RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local scripts only (npm run logs, seeding). NEVER put this on Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Eval runner only (test account in the Eval Workshop).
EVAL_EMAIL=
EVAL_PASSWORD=

# Optional login hint on /login (the password is never in the UI).
NEXT_PUBLIC_DEMO_EMAIL=

# The LLM key is NOT here. GEMINI_API_KEY and GEMINI_MODEL (default gemini-2.5-flash-lite)
# live in Supabase secrets: npx supabase secrets set GEMINI_API_KEY=... (decision D26).
